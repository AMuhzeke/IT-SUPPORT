import os

import sys

import ctypes

import subprocess

import tkinter as tk

from tkinter import messagebox, scrolledtext

import threading





class PrinterToolGUI:

    def __init__(self, root):

        self.root = root

        self.root.title("Gemini Enterprise - Printer Troubleshooter")

        self.root.geometry("700x550")

        self.root.configure(bg="#1e1e2e")

        

        # --- UI Styling ---

        self.title_font = ("Segoe UI", 14, "bold")

        self.text_font = ("Consolas", 10)

        self.btn_font = ("Segoe UI", 10, "bold")

        

        # Header Section

        self.header = tk.Label(

            root, 

            text="🛠️ AUTOMATED PRINTER TROUBLESHOOTER", 

            font=self.title_font, 

            fg="#cdd6f4", 

            bg="#1e1e2e",

            pady=15

        )

        self.header.pack()

        

        # Action Buttons Container

        self.btn_frame = tk.Frame(root, bg="#1e1e2e")

        self.btn_frame.pack(pady=10)

        

        # Run Button

        self.run_btn = tk.Button(

            self.btn_frame, 

            text="🚀 RUN DIAGNOSTICS & CLEAN", 

            font=self.btn_font, 

            bg="#a6e3a1", 

            fg="#11111b",

            padx=15, 

            pady=8, 

            activebackground="#89b4fa",

            command=self.start_process_thread

        )

        self.run_btn.grid(row=0, column=0, padx=10)

        

        # Clear Terminal Button

        self.clear_btn = tk.Button(

            self.btn_frame, 

            text="🧹 CLEAR LOG", 

            font=self.btn_font, 

            bg="#f38ba8", 

            fg="#11111b",

            padx=15, 

            pady=8, 

            activebackground="#f5e0dc",

            command=self.clear_log

        )

        self.clear_btn.grid(row=0, column=1, padx=10)



        # Status Label

        self.status_label = tk.Label(

            root, 

            text="System Ready. Click 'RUN DIAGNOSTICS' to begin.", 

            font=("Segoe UI", 10, "italic"), 

            fg="#9399b2", 

            bg="#1e1e2e",

            pady=5

        )

        self.status_label.pack()



        # Terminal Output Box

        self.terminal = scrolledtext.ScrolledText(

            root, 

            font=self.text_font, 

            bg="#181825", 

            fg="#a6e3a1", 

            insertbackground="white", 

            wrap=tk.WORD,

            borderwidth=0,

            highlightthickness=1,

            highlightcolor="#45475a"

        )

        self.terminal.pack(fill=tk.BOTH, expand=True, padx=20, pady=20)

        

    def log(self, text):

        self.terminal.insert(tk.END, text + "\n")

        self.terminal.see(tk.END)

        

    def clear_log(self):

        self.terminal.delete('1.0', tk.END)

        self.status_label.config(text="Log cleared. Ready.", fg="#9399b2")



    def start_process_thread(self):

        self.run_btn.config(state=tk.DISABLED)

        self.status_label.config(text="⚙️ Troubleshooting in progress... Please wait.", fg="#f9e2af")

        self.clear_log()

        thread = threading.Thread(target=self.run_printer_troubleshooter)

        thread.start()



    def run_printer_troubleshooter(self):

        powershell_script = """

        $OutputEncoding = [System.Text.Encoding]::UTF8

        Write-Output "🔍 [STEP 1/6] Auto-detecting network printers..."

        $printers = Get-CimInstance -ClassName Win32_Printer | Where-Object { $_.Network -or $_.PortName -like '*.*' -or $_.PortName -match '^\\d{1,3}\\.' }

        if (-not $printers) { $printers = Get-CimInstance -ClassName Win32_Printer }

        

        $printerStatusTable = @()

        foreach ($printer in $printers) {

            $address = $printer.PortName

            if ($address -match 'IP_(.*)') { $address = $Matches[1] }

            if ($address -match '^(LPT|COM|USB|PORTPROMPT|pdf|nul|Microsoft|shrd)') { continue }

            

            Write-Output "📡 Testing connection to: $($printer.Name) ($address)..."

            $pingTest = Test-Connection -ComputerName $address -Count 1 -Quiet -ErrorAction SilentlyContinue

            $status = if ($pingTest) { "ONLINE" } else { "OFFLINE" }

            $printerStatusTable += [PSCustomObject]@{'Printer'=$printer.Name; 'Address'=$address; 'Status'=$status}

        }

        if ($printerStatusTable) { 

            Write-Output "`n📊 NETWORK PRINTER STATUS:"

            $printerStatusTable | Format-Table -AutoSize | Out-String | Write-Output

        }

        

        Write-Output "`n📋 [STEP 2/6] Checking current queue..."

        $jobs = Get-PrintJob -PrinterName * -ErrorAction SilentlyContinue

        if ($jobs) { 

            Write-Output "⚠️ Found $($jobs.Count) stuck jobs."

            $jobs | Select-Object PrinterName, ID, DocumentName | Format-Table -AutoSize | Out-String | Write-Output

        } else { 

            Write-Output "✅ Print queue is already empty." 

        }

        

        Write-Output "`n🛑 [STEP 3/6] Stopping Print Spooler service..."

        Stop-Service -Name "Spooler" -Force -ErrorAction SilentlyContinue

        if ((Get-Service -Name "Spooler").Status -ne 'Stopped') {

            Write-Output "❌ CRITICAL: Failed to stop Print Spooler."

            Exit

        }

        Write-Output "✅ Print Spooler stopped successfully."

        

        Write-Output "`n🧹 [STEP 4/6] Clearing stuck print queue files..."

        $spoolPath = "$env:SystemRoot\\System32\\spool\\PRINTERS"

        try {

            Get-ChildItem -Path $spoolPath -Include *.spl, *.shd -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue

            Write-Output "✅ Print spool directory files purged."

        } catch {

            Write-Output "⚠️ Spool folder was already empty or file locked."

        }

        

        Write-Output "`n🚀 [STEP 5/6] Starting Print Spooler service..."

        Start-Service -Name "Spooler" -ErrorAction SilentlyContinue

        if ((Get-Service -Name "Spooler").Status -eq 'Running') {

            Write-Output "✅ Print Spooler has successfully restarted."

        } else {

            Write-Output "❌ CRITICAL: Failed to start Print Spooler."

            Exit

        }

        

        Write-Output "`n🔄 [STEP 6/6] Finalizing queue verification..."

        $finalJobs = Get-PrintJob -PrinterName * -ErrorAction SilentlyContinue

        if (-not $finalJobs) {

            Write-Output "`n🎉 SUCCESS: Printer queue is clear and Spooler is healthy!"

        } else {

            Write-Output "`n⚠️ WARNING: Active jobs still persist. Physical hardware intervention may be required."

        }

        """



        try:

            process = subprocess.Popen(

                ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", powershell_script],

                stdout=subprocess.PIPE,

                stderr=subprocess.PIPE,

                text=True,

                creationflags=subprocess.CREATE_NO_WINDOW

            )

            for line in process.stdout:

                self.log(line.strip())

            process.wait()



            if process.returncode == 0:

                self.status_label.config(text="✅ Maintenance Completed Successfully!", fg="#a6e3a1")

            else:

                err_output = process.stderr.read()

                self.log(f"\n❌ Error during execution:\n{err_output}")

                self.status_label.config(text="❌ Script execution failed.", fg="#f38ba8")



        except Exception as e:

            self.log(f"\n❌ Python system exception: {str(e)}")

            self.status_label.config(text="❌ Interface Error.", fg="#f38ba8")

        finally:

            self.run_btn.config(state=tk.NORMAL)





def is_admin():

    try:

        return ctypes.windll.shell32.IsUserAnAdmin()

    except:

        return False





if __name__ == "__main__":

    if is_admin():

        root = tk.Tk()

        app = PrinterToolGUI(root)

        root.mainloop()

    else:

        print("🛡️ Requesting Administrator rights...")

        ctypes.windll.shell32.ShellExecuteW(None, "runas", sys.executable, " ".join(sys.argv), None, 1)



